resource "aws_lambda_function" "ir" {
  function_name = "${var.project_name}-ir-reporter"

  filename         = "${path.module}/lambda/lambda_ir_reporter.zip"
  source_code_hash = filebase64sha256(
    "${path.module}/lambda/lambda_ir_reporter.zip"
  )

  role    = aws_iam_role.ir_role.arn
  handler = "handler.lambda_handler"
  runtime = "python3.11"
  timeout = 60

  environment {
    variables = {
      REPORT_BUCKET    = aws_s3_bucket.ir_reports.bucket
      APP_LOG_GROUP    = var.app_log_group
      WAF_LOG_GROUP    = var.waf_log_group
      SECRET_ID        = "${var.project_name}/rds/mysql"
      SSM_PARAM_PATH   = "/lab/db/"
      BEDROCK_MODEL_ID = var.bedrock_model_id
      SNS_TOPIC_ARN    = var.sns_topic_arn
    }
  }
}
